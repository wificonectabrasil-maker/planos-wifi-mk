# Banco: credenciais somente no servidor
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Site e painel
SITE_URL=https://wificonecta.com.br
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_DISABLE_AUTH=0
ADMIN_UPLOAD_MAX_MB=6
NEXT_PUBLIC_ALLOW_INDEXING=false

# Serviços opcionais: IA e pesquisa (independentes do banco)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPER_API_KEY=
SERPAPI_KEY=

# Integração WordPress: gere uma application password no painel.
# WP_FAKE_USER e WP_FAKE_PASSWORD são alternativas opcionais para desenvolvimento.
# WifiConecta: configurar com canais e domínio reais antes da publicação.
# WhatsApp com DDD; aceita número nacional ou com código 55.
WIFICONECTA_WHATSAPP=
WIFICONECTA_CONTACT_EMAIL=
